# ==============================================================================
# Recovra - Environment Configuration
# ==============================================================================

# LiveKit Real-Time WebRTC Credentials (https://cloud.livekit.io or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Public LiveKit URL for Frontend WebRTC Audio Connection
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_AGENT_NAME=recovra-collection-agent

# LiveKit SIP Telephony
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_SIP_CALLER_NUMBER=+19897474190

# Shared Agent-to-CRM API Key for secure authentication
CRM_AGENT_API_KEY=your_crm_agent_api_key_secret

# CRM Application Settings
PORT=3000
NODE_ENV=production
HOSTNAME=0.0.0.0
CRM_API_BASE=http://localhost:3000/api
BETTER_AUTH_SECRET=your_better_auth_secret
BETTER_AUTH_URL=http://localhost:3000

# Persistent MongoDB Database
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/collection_crm

# SMTP Email Integration (Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=recovraai@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Recovra <recovraai@gmail.com>"

# AI Speech and LLM APIs for Voice Agent (voice_agent/agent.py)
# Google Gemini (Primary Default LLM: 30 RPM, instant TTFT)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq LPU Engine (Backup LLM)
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BACKUP_MODEL=openai/gpt-oss-120b

# Deepgram (Default Primary STT & TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-asteria-en


# Sarvam AI (Indian accents STT / Bulbul TTS)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=kavya

# Cartesia Sonic-3 (Backup TTS)
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_TTS_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4

# OpenAI (Fallback LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
