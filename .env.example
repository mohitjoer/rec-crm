# Discord Bot Token - Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Channel ID where videos will be posted
DISCORD_CHANNEL_ID=your_channel_id_here

# YouTube API Key - Get from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube Channel IDs to monitor (comma-separated)
# You can find channel IDs by going to a channel and looking at the URL
# Example: https://www.youtube.com/channel/UC_x5XG1OV2P6uZZ5FSM9Ttw
YOUTUBE_CHANNEL_IDS=channel_id_1,channel_id_2,channel_id_3

# Check interval in minutes (default: 10)
CHECK_INTERVAL_MINUTES=10
